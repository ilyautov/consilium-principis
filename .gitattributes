# Normalize line endings: LF in the repo, checked out as LF everywhere.
# Prevents CRLF drift when the repo is cloned on Windows.
* text=auto eol=lf

# Windows batch scripts expect CRLF.
*.bat text eol=crlf

# Binary assets — never touch line endings, never diff as text.
*.png binary
*.gif binary
*.mp4 binary
*.webm binary
*.npy binary
