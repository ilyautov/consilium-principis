# Consilium Principis — пример локального .env (скопируй в .env, оно gitignored).
#
# ВСЁ здесь ОПЦИОНАЛЬНО. Ядро (совет + контур верности) работает на агенте, который у тебя уже
# есть, без единого ключа. Эти переменные — только если хочешь семантик-ретрив (FULL) или opt-in
# облачного судью. Секреты (.env*) НИКОГДА не коммитятся.

# ── Opt-in облако (по умолчанию всё локально) ────────────────────────────────
# Ключ OpenRouter — нужен ТОЛЬКО если включаешь api-тир судьи релевантности. Без него судья
# локальный (host/ollama), контур верности от этого не слабеет. Ротируй при утечке.
# OPENROUTER_API_KEY=

# ── FULL-тир (семантический ретрив: ollama + bge-m3 + numpy) ──────────────────
# Адрес ollama, если не дефолтный. Проверь настройку: `python3 scripts/setup_full.py`,
# диагностика: `python3 scripts/doctor.py`. Помни: FULL требует ещё и `pip install numpy`.
# OLLAMA_HOST=http://127.0.0.1:11434
# EMBED_MODEL=bge-m3

# tier-FULL через внешний движок (Гефест) — путь к нему; пусто → SIMPLE/лексика (контур цел).
# HEPHAESTUS_ENGINE=

# Бэкенд судьи релевантности: host | ollama | api (по умолчанию host — судит агент-хост).
# LLM_BACKEND=host

# ── Язык интерфейса совета ────────────────────────────────────────────────────
# ru | en (по умолчанию определяется автоматически).
# CONSILIUM_LANG=ru

# ── Dev/eval (обычному пользователю не нужны) ─────────────────────────────────
# RUN_NET_TESTS=1            # включить тесты, ходящие в сеть (Gutenberg и т.п.)
# PROBE_ADVISOR_NAMES=       # калибровка контаминации: имена для closed-book пробы
