{
  "manifest_version": "0.3",
  "name": "consilium-principis",
  "display_name": "Consilium Principis",
  "version": "0.1.2",
  "description": "Личный совет директоров из AI-персон реальных мыслителей, заземлённый в public-domain текстах, с контуром верности (дословные 🔵-цитаты, fail-closed воздержание).",
  "author": {
    "name": "Ilya Autov",
    "email": "ilyautov@gmail.com"
  },
  "homepage": "https://github.com/ilyautov/consilium-principis",
  "repository": {
    "type": "git",
    "url": "https://github.com/ilyautov/consilium-principis"
  },
  "license": "MIT",
  "server": {
    "type": "python",
    "entry_point": "scripts/mcp_server.py",
    "mcp_config": {
      "command": "python3",
      "args": ["${__dirname}/scripts/mcp_server.py"],
      "platform_overrides": {
        "win32": {
          "command": "py",
          "args": ["-3", "${__dirname}/scripts/mcp_server.py"]
        }
      }
    }
  }
}
